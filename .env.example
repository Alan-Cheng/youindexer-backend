POSTGRES_DB=youindexer
POSTGRES_USER=youindexer
POSTGRES_PASSWORD=youindexer
POSTGRES_PORT=5433
DATABASE_URL=postgresql://youindexer:youindexer@localhost:5433/youindexer

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

TRANSCRIPTION_WORKER_CPUS=0.5
TRANSCRIPTION_WORKER_MEMORY_LIMIT=512m
INDEX_WORKER_CPUS=0.5
INDEX_WORKER_MEMORY_LIMIT=512m
CELERY_BEAT_CPUS=0.25
CELERY_BEAT_MEMORY_LIMIT=256m
# Optional Netscape-format cookies file for videos that require authentication.
# YOUTUBE_COOKIES_FILE=/absolute/path/to/youtube-cookies.txt

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_BUCKET=youindexer

OPENSEARCH_PORT=9200
OPENSEARCH_PERFORMANCE_ANALYZER_PORT=9600
OPENSEARCH_DASHBOARDS_PORT=5601
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_SUBTITLE_INDEX=subtitle-segments-v1
OPENSEARCH_SUBTITLE_ALIAS=subtitle-segments
OPENSEARCH_CPUS=1.0
OPENSEARCH_MEMORY_LIMIT=1g
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
OPENSEARCH_DASHBOARDS_CPUS=0.5
OPENSEARCH_DASHBOARDS_MEMORY_LIMIT=512m
OPENSEARCH_DASHBOARDS_NODE_OPTIONS=--max-old-space-size=256
